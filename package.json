{
  "name": "cuttan-video-lut-editor",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/copy-ffmpeg.mjs && vite --host 0.0.0.0",
    "build": "node scripts/copy-ffmpeg.mjs && tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -b",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "lint": "tsc -b --pretty false",
    "android:add": "npm run build && cap add android"
  },
  "dependencies": {
    "@capacitor/android": "6.2.0",
    "@capacitor/core": "6.2.0",
    "@ffmpeg/core": "0.12.6",
    "@ffmpeg/ffmpeg": "0.12.15",
    "@ffmpeg/util": "0.12.2",
    "@vitejs/plugin-react": "4.3.4",
    "lucide-react": "0.468.0",
    "mediabunny": "1.62.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "vite": "6.0.7"
  },
  "devDependencies": {
    "@capacitor/cli": "6.2.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "typescript": "5.7.2"
  }
}
