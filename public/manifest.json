
{
  "name": "CUTTAN Video LUT Editor",
  "short_name": "CUTTAN",
  "description": "Local-first video colour and trim studio",
  "id": "/",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "browser"],
  "orientation": "portrait-primary",
  "background_color": "#100817",
  "theme_color": "#100817",
  "lang": "en",
  "dir": "ltr",
  "categories": ["photo", "video", "utilities"],
  "iarc_rating_id": "e84b072d-71b3-4d3e-86ae-e961737f5c94",
  "icons": [
    { "src": "/icons/cuttan-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/cuttan-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/cuttan-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "screenshots": [
    { "src": "/icons/cuttan-512.png", "sizes": "512x512", "type": "image/png", "form_factor": "wide", "label": "CUTTAN Desktop" },
    { "src": "/icons/cuttan-512.png", "sizes": "512x512", "type": "image/png", "form_factor": "narrow", "label": "CUTTAN Mobile" }
  ],
  "shortcuts": [
    { "name": "Open Editor", "url": "/?shortcut=editor", "icons": [{ "src": "/icons/cuttan-192.png", "sizes": "192x192" }] }
  ],
  "launch_handler": { "client_mode": ["navigate-existing", "auto"] },
  "handle_links": "preferred",
  "file_handlers": [{ "action": "/", "accept": { "video/*": [".mp4", ".mov"] } }],
  "share_target": { "action": "/", "method": "POST", "enctype": "multipart/form-data", "params": { "files": [{ "name": "video", "accept": ["video/*"] }] } },
  "protocol_handlers": [{ "protocol": "web+cuttan", "url": "/?protocol=%s" }],
  "related_applications": [],
  "prefer_related_applications": false
}
